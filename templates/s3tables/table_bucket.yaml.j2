---
Description: {{sceptre_user_data.description|default('S3Tables Table Bucket(s) for '+sceptre_user_data.project_code)}}
AWSTemplateFormatVersion: "2010-09-09"

Resources:
{%- for table_bucket in sceptre_user_data.table_buckets %}
{%- set table_bucket_name = table_bucket.name %}
  {{ table_bucket_name }}:
    Type: AWS::S3Tables::TableBucket
    DeletionPolicy: {{ table_bucket.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ table_bucket.update_replace_policy | default('Delete') }}
    Properties:
      TableBucketName: {{ table_bucket.table_bucket_name }}
{%- if table_bucket.encryption_configuration is defined %}{# BEGIN if table_bucket.encryption_configuration is defined #}
      EncryptionConfiguration:
{%- if table_bucket.encryption_configuration.kms_key_arn is defined %}
        KMSKeyArn: {{ table_bucket.encryption_configuration.kms_key_arn | trim }}
{%- endif %}
{%- if table_bucket.encryption_configuration.sse_algorithm is defined %}
        SSEAlgorithm: {{ table_bucket.encryption_configuration.sse_algorithm }}
{%- endif %}
{%- endif %}{# END if table_bucket.encryption_configuration is defined #}
{%- if table_bucket.metrics_configuration is defined %}{# BEGIN if table_bucket.metrics_configuration is defined #}
      MetricsConfiguration:
{%- if table_bucket.metrics_configuration.status is defined %}
        Status: {{ table_bucket.metrics_configuration.status }}
{%- endif %}
{%- endif %}{# END if table_bucket.metrics_configuration is defined #}
{%- if table_bucket.replication_configuration is defined %}{# BEGIN if table_bucket.replication_configuration is defined #}
      ReplicationConfiguration:
        Role: {{ table_bucket.replication_configuration.role | trim }}
        Rules:
{%- for rule in table_bucket.replication_configuration.rules %}{# BEGIN for rule in table_bucket.replication_configuration.rules #}
          -
            Destinations:
{%- for destination in rule.destinations %}
              -
                DestinationTableBucketARN: {{ destination.destination_table_bucket_arn | trim }}
{%- endfor %}
{%- endfor %}{# END for rule in table_bucket.replication_configuration.rules #}
{%- endif %}{# END if table_bucket.replication_configuration is defined #}
{%- if table_bucket.storage_class_configuration is defined %}{# BEGIN if table_bucket.storage_class_configuration is defined #}
      StorageClassConfiguration:
{%- if table_bucket.storage_class_configuration.storage_class is defined %}
        StorageClass: {{ table_bucket.storage_class_configuration.storage_class }}
{%- endif %}
{%- endif %}{# END if table_bucket.storage_class_configuration is defined #}
      Tags:
        - Key: SourceRepoURL
          Value: {{ sceptre_user_data.source_repo_url | default('unknown') }}
{%- if table_bucket.tags is defined %}
{%- for key,value in table_bucket.tags.items() %}
        - Key: {{ key }}
          Value: {{ value }}
{%- endfor %}
{%- endif %}
{%- if table_bucket.unreferenced_file_removal is defined %}{# BEGIN if table_bucket.unreferenced_file_removal is defined #}
      UnreferencedFileRemoval:
{%- if table_bucket.unreferenced_file_removal.noncurrent_days is defined %}
        NoncurrentDays: {{ table_bucket.unreferenced_file_removal.noncurrent_days }}
{%- endif %}
{%- if table_bucket.unreferenced_file_removal.status is defined %}
        Status: {{ table_bucket.unreferenced_file_removal.status }}
{%- endif %}
{%- if table_bucket.unreferenced_file_removal.unreferenced_days is defined %}
        UnreferencedDays: {{ table_bucket.unreferenced_file_removal.unreferenced_days }}
{%- endif %}
{%- endif %}{# END if table_bucket.unreferenced_file_removal is defined #}
{%- if table_bucket.table_bucket_policy is defined %}{# BEGIN if table_bucket.table_bucket_policy is defined #}
  {{ table_bucket_name }}Policy:
    Type: AWS::S3Tables::TableBucketPolicy
    DeletionPolicy: {{ table_bucket.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ table_bucket.update_replace_policy | default('Delete') }}
    Properties:
{%- if table_bucket.table_bucket_policy.resource_policy_json is defined %}
      ResourcePolicy: |-
        {{ table_bucket.table_bucket_policy.resource_policy_json | indent(width=8, first=false) }}
{%- else %}
      ResourcePolicy:
        {{ table_bucket.table_bucket_policy.resource_policy | indent(width=8, first=false) }}
{%- endif %}
      TableBucketARN:
        Fn::GetAtt:
          - {{ table_bucket_name }}
          - TableBucketARN
{%- endif %}{# END if table_bucket.table_bucket_policy is defined #}
{%- if table_bucket.namespace is defined %}{# BEGIN if table_bucket.namespace is defined #}
  {{ table_bucket_name }}Namespace:
    Type: AWS::S3Tables::Namespace
    DeletionPolicy: {{ table_bucket.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ table_bucket.update_replace_policy | default('Delete') }}
    Properties:
      Namespace: {{ table_bucket.namespace }}
      TableBucketARN:
        Fn::GetAtt:
          - {{ table_bucket_name }}
          - TableBucketARN
{%- endif %}{# END if table_bucket.namespace is defined #}
{%- endfor %}

Outputs:
{%- for table_bucket in sceptre_user_data.table_buckets %}
{%- set table_bucket_name = table_bucket.name %}
  {{ table_bucket_name }}:
    Description: The table bucket name for {{ table_bucket_name }}
    Value:
      Ref: {{ table_bucket_name }}
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ table_bucket_name }}"
  {{ table_bucket_name }}TableBucketARN:
    Description: The ARN for {{ table_bucket_name }}
    Value:
      Fn::GetAtt:
        - {{ table_bucket_name }}
        - TableBucketARN
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ table_bucket_name }}-TableBucketARN"
{%- endfor %}{#
# Supported structure as of 2026-07-05:
Type: AWS::S3Tables::TableBucket
Properties:
  EncryptionConfiguration:
    KMSKeyArn: String
    SSEAlgorithm: String
  MetricsConfiguration:
    Status: String
  ReplicationConfiguration:
    Role: String
    Rules:
      -
        Destinations:
          -
            DestinationTableBucketARN: String
  StorageClassConfiguration:
    StorageClass: String
  TableBucketName: String
  Tags:
    - Key: String
      Value: String
  UnreferencedFileRemoval:
    NoncurrentDays: Integer
    Status: String
    UnreferencedDays: Integer

Type: AWS::S3Tables::TableBucketPolicy
Properties:
  ResourcePolicy: Json
  TableBucketARN: String

Type: AWS::S3Tables::Namespace
Properties:
  Namespace: String
  TableBucketARN: String
#}