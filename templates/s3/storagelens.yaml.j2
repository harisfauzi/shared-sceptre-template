---
{%- import "macros/storage-lens-helper.yaml.j2" as helper %}
Description: {{sceptre_user_data.description|default('S3 Storage Lens(s) for '+sceptre_user_data.project_code)}}
AWSTemplateFormatVersion: "2010-09-09"

Resources:
{%- for storage_lens in sceptre_user_data.storage_lenses %}{# BEGIN for storage_lens in sceptre_user_data.storage_lenses #}
{%- set storage_lens_name = storage_lens.name %}
  {{ storage_lens_name }}:
    Type: AWS::S3::StorageLens
    DeletionPolicy: {{ storage_lens.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ storage_lens.update_replace_policy | default('Delete') }}
    Properties:
      StorageLensConfiguration:
        AccountLevel:
          BucketLevel:
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.activity_metrics is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.bucket_level.activity_metrics is defined #}
            ActivityMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.activity_metrics.is_enabled is defined %}
              IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.bucket_level.activity_metrics.is_enabled | lower }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.bucket_level.activity_metrics is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_cost_optimization_metrics is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_cost_optimization_metrics is defined #}
            AdvancedCostOptimizationMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_cost_optimization_metrics.is_enabled is defined %}
              IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_cost_optimization_metrics.is_enabled | lower }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_cost_optimization_metrics is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_data_protection_metrics is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_data_protection_metrics is defined #}
            AdvancedDataProtectionMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_data_protection_metrics.is_enabled is defined %}
              IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_data_protection_metrics.is_enabled | lower }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.bucket_level.advanced_data_protection_metrics is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.detailed_status_codes_metrics is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.bucket_level.detailed_status_codes_metrics is defined #}
            DetailedStatusCodesMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.detailed_status_codes_metrics.is_enabled is defined %}
              IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.bucket_level.detailed_status_codes_metrics.is_enabled | lower }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.bucket_level.detailed_status_codes_metrics is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level is defined #}
            PrefixLevel:
              StorageMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.is_enabled is defined %}
                IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.is_enabled | lower }}
{%- endif %}
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria is defined #}
                SelectionCriteria:
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria.delimiter is defined %}
                  Delimiter: {{ storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria.delimiter }}
{%- endif %}
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria.max_depth is defined %}
                  MaxDepth: {{ storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria.max_depth }}
{%- endif %}
{%- if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria.min_storage_bytes_percentage is defined %}
                  MinStorageBytesPercentage: {{ storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria.min_storage_bytes_percentage }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level.storage_metrics.selection_criteria is defined #}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.bucket_level.prefix_level is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.activity_metrics is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.activity_metrics is defined #}
          ActivityMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.activity_metrics.is_enabled is defined %}
            IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.activity_metrics.is_enabled | lower }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.activity_metrics is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.advanced_cost_optimization_metrics is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.advanced_cost_optimization_metrics is defined #}
          AdvancedCostOptimizationMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.advanced_cost_optimization_metrics.is_enabled is defined %}
            IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.advanced_cost_optimization_metrics.is_enabled | lower }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.advanced_cost_optimization_metrics is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.advanced_data_protection_metrics is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.advanced_data_protection_metrics is defined #}
          AdvancedDataProtectionMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.advanced_data_protection_metrics.is_enabled is defined %}
            IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.advanced_data_protection_metrics.is_enabled | lower }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.advanced_data_protection_metrics is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.detailed_status_codes_metrics is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.detailed_status_codes_metrics is defined #}
          DetailedStatusCodesMetrics:
{%- if storage_lens.storage_lens_configuration.account_level.detailed_status_codes_metrics.is_enabled is defined %}
            IsEnabled: {{ storage_lens.storage_lens_configuration.account_level.detailed_status_codes_metrics.is_enabled | lower }}
{%- endif %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.detailed_status_codes_metrics is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level is defined #}
          StorageLensGroupLevel:
{%- if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria is defined #}
            StorageLensGroupSelectionCriteria:
{%- if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria.exclude is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria.exclude is defined #}
              Exclude:
{%- for item in storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria.exclude %}
                - {{ item }}
{%- endfor %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria.exclude is defined #}
{%- if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria.include is defined %}{# BEGIN if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria.include is defined #}
              Include:
{%- for item in storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria.include %}
                - {{ item }}
{%- endfor %}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria.include is defined #}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level.storage_lens_group_selection_criteria is defined #}
{%- endif %}{# END if storage_lens.storage_lens_configuration.account_level.storage_lens_group_level is defined #}
        Id: {{ storage_lens.storage_lens_configuration.id }}
        IsEnabled: {{ storage_lens.storage_lens_configuration.is_enabled | lower }}
{%- if storage_lens.storage_lens_configuration.aws_org is defined %}
        AwsOrg:
          Arn: {{ storage_lens.storage_lens_configuration.aws_org.arn | trim }}
{%- endif %}
{%- if storage_lens.storage_lens_configuration.data_export is defined %}{# BEGIN if storage_lens.storage_lens_configuration.data_export is defined #}
        DataExport:
{%- if storage_lens.storage_lens_configuration.data_export.cloud_watch_metrics is defined %}
          CloudWatchMetrics:
            IsEnabled: {{ storage_lens.storage_lens_configuration.data_export.cloud_watch_metrics.is_enabled | lower }}
{%- endif %}
{%- if storage_lens.storage_lens_configuration.data_export.s3_bucket_destination is defined %}{# BEGIN if storage_lens.storage_lens_configuration.data_export.s3_bucket_destination is defined #}
          S3BucketDestination:
            {{- helper.prep_s3_bucket_destination(storage_lens.storage_lens_configuration.data_export.s3_bucket_destination) | indent(width=12, first=false) }}
{%- endif %}{# END if storage_lens.storage_lens_configuration.data_export.s3_bucket_destination is defined #}
{%- if storage_lens.storage_lens_configuration.data_export.storage_lens_table_destination is defined %}{# BEGIN if storage_lens.storage_lens_configuration.data_export.storage_lens_table_destination is defined #}
          StorageLensTableDestination:
            {{- helper.prep_storage_lens_table_destination(storage_lens.storage_lens_configuration.data_export.storage_lens_table_destination) | indent(width=12, first=false) }}
{%- endif %}{# END if storage_lens.storage_lens_configuration.data_export.storage_lens_table_destination is defined #}
{%- endif %}{# END if storage_lens.storage_lens_configuration.data_export is defined #}
{%- if storage_lens.storage_lens_configuration.exclude is defined %}{# BEGIN if storage_lens.storage_lens_configuration.exclude is defined #}
        Exclude:
          {{- helper.prep_buckets_and_regions(storage_lens.storage_lens_configuration.exclude) | indent(width=10, first=false) }}
{%- endif %}{# END if storage_lens.storage_lens_configuration.exclude is defined #}
{%- if storage_lens.storage_lens_configuration.expanded_prefixes_data_export is defined %}{# BEGIN if storage_lens.storage_lens_configuration.expanded_prefixes_data_export is defined #}
        ExpandedPrefixesDataExport:
{%- if storage_lens.storage_lens_configuration.expanded_prefixes_data_export.s3_bucket_destination is defined %}{# BEGIN if storage_lens.storage_lens_configuration.expanded_prefixes_data_export.s3_bucket_destination is defined #}
          S3BucketDestination:
            {{- helper.prep_s3_bucket_destination(storage_lens.storage_lens_configuration.expanded_prefixes_data_export.s3_bucket_destination) | indent(width=12, first=false) }}
{%- endif %}{# END if storage_lens.storage_lens_configuration.expanded_prefixes_data_export.s3_bucket_destination is defined #}
{%- if storage_lens.storage_lens_configuration.expanded_prefixes_data_export.storage_lens_table_destination is defined %}{# BEGIN if storage_lens.storage_lens_configuration.expanded_prefixes_data_export.storage_lens_table_destination is defined #}
          StorageLensTableDestination:
            {{- helper.prep_storage_lens_table_destination(storage_lens.storage_lens_configuration.expanded_prefixes_data_export.storage_lens_table_destination) | indent(width=12, first=false) }}
{%- endif %}{# END if storage_lens.storage_lens_configuration.expanded_prefixes_data_export.storage_lens_table_destination is defined #}
{%- endif %}{# END if storage_lens.storage_lens_configuration.expanded_prefixes_data_export is defined #}
{%- if storage_lens.storage_lens_configuration.include is defined %}{# BEGIN if storage_lens.storage_lens_configuration.include is defined #}
        Include:
          {{- helper.prep_buckets_and_regions(storage_lens.storage_lens_configuration.include) | indent(width=10, first=false) }}
{%- endif %}{# END if storage_lens.storage_lens_configuration.include is defined #}
{%- if storage_lens.storage_lens_configuration.prefix_delimiter is defined %}
        PrefixDelimiter: {{ storage_lens.storage_lens_configuration.prefix_delimiter }}
{%- endif %}
{%- if storage_lens.storage_lens_configuration.storage_lens_arn is defined %}
        StorageLensArn: {{ storage_lens.storage_lens_configuration.storage_lens_arn | trim }}
{%- endif %}
      Tags:
        - Key: SourceRepoURL
          Value: {{ sceptre_user_data.source_repo_url | default('unknown') }}
{%- if storage_lens.tags is defined %}
{%- for key,value in storage_lens.tags.items() %}
        - Key: {{ key }}
          Value: {{ value }}
{%- endfor %}
{%- endif %}
{%- endfor %}{# END for storage_lens in sceptre_user_data.storage_lenses #}

Outputs:
{%- for storage_lens in sceptre_user_data.storage_lenses %}
{%- set storage_lens_name = storage_lens.name %}
  {{ storage_lens_name }}:
    Description: Storage Lens Configuration Id for {{ storage_lens_name }}
    Value:
      Ref: {{ storage_lens_name }}
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ storage_lens_name }}"
  {{ storage_lens_name }}Arn:
    Description: The ARN for {{ storage_lens_name }}
    Value:
      Fn::GetAtt:
        - {{ storage_lens_name }}
        - StorageLensConfiguration.StorageLensArn
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ storage_lens_name }}-Arn"
{%- endfor %}{#
# Supported structure as of 2026-07-05:
Type: AWS::S3::StorageLens
Properties:
  StorageLensConfiguration:
    AccountLevel:
      ActivityMetrics:
        IsEnabled: Boolean
      AdvancedCostOptimizationMetrics:
        IsEnabled: Boolean
      AdvancedDataProtectionMetrics:
        IsEnabled: Boolean
      BucketLevel:
        ActivityMetrics:
          IsEnabled: Boolean
        AdvancedCostOptimizationMetrics:
          IsEnabled: Boolean
        AdvancedDataProtectionMetrics:
          IsEnabled: Boolean
        AdvancedPerformanceMetrics:
          IsEnabled: Boolean
        DetailedStatusCodesMetrics:
          IsEnabled: Boolean
        PrefixLevel:
          StorageMetrics:
            IsEnabled: Boolean
            SelectionCriteria:
              Delimiter: String
              MaxDepth: Integer
              MinStorageBytesPercentage: Number
      DetailedStatusCodesMetrics:
        IsEnabled: Boolean
      StorageLensGroupLevel:
        StorageLensGroupSelectionCriteria:
          Exclude:
            - String
          Include:
            - String
    AwsOrg:
      Arn: String
    DataExport:
      CloudWatchMetrics:
        IsEnabled: Boolean
      S3BucketDestination:
        AccountId: String
        Arn: String
        Encryption:
          SSEKMS:
            KeyId: String
          SSES3: Json
        Format: String
        OutputSchemaVersion: String
        Prefix: String
      StorageLensTableDestination:
        Encryption:
          SSEKMS:
            KeyId: String
          SSES3: Json
        IsEnabled: Boolean
    Exclude:
      Buckets:
        - String
      Regions:
        - String
    ExpandedPrefixesDataExport:
      S3BucketDestination:
        AccountId: String
        Arn: String
        Encryption:
          SSEKMS:
            KeyId: String
          SSES3: Json
        Format: String
        OutputSchemaVersion: String
        Prefix: String
      StorageLensTableDestination:
        Encryption:
          SSEKMS:
            KeyId: String
          SSES3: Json
        IsEnabled: Boolean
    Id: String
    Include:
      Buckets:
        - String
      Regions:
        - String
    IsEnabled: Boolean
    PrefixDelimiter: String
    StorageLensArn: String
  Tags:
    -
      Key: String
      Value: String
#}