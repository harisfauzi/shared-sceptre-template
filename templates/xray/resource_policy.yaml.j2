---
Description: {{sceptre_user_data.description|default('XRay Resource Policy(s) for '+sceptre_user_data.project_code)}}
AWSTemplateFormatVersion: "2010-09-09"

Resources:
{%- for resource_policy in sceptre_user_data.resource_policies %}
{%- set resource_policy_name = resource_policy.name %}
  {{ resource_policy_name }}:
    Type: AWS::XRay::ResourcePolicy
    DeletionPolicy: {{ resource_policy.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ resource_policy.update_replace_policy | default('Delete') }}
    Properties:
      PolicyName: {{ resource_policy.policy_name }}
      PolicyDocument: |-
        {{ resource_policy.policy_document | indent(width=8, first=false) }}
{%- if resource_policy.bypass_policy_lockout_check is defined %}
      BypassPolicyLockoutCheck: {{ resource_policy.bypass_policy_lockout_check | lower }}
{%- endif %}
{%- endfor %}

Outputs:
{%- for resource_policy in sceptre_user_data.resource_policies %}
{%- set resource_policy_name = resource_policy.name %}
  {{ resource_policy_name }}:
    Description: The policy name for {{ resource_policy_name }}
    Value:
      Ref: {{ resource_policy_name }}
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ resource_policy_name }}"
{%- endfor %}{#
# Supported structure as of 2026-08-10
Type: AWS::XRay::ResourcePolicy
Properties:
  BypassPolicyLockoutCheck: Boolean
  PolicyDocument: String
  PolicyName: String
#}