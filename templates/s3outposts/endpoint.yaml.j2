---
Description: {{sceptre_user_data.description|default('S3Outposts Endpoint(s) for '+sceptre_user_data.project_code)}}
AWSTemplateFormatVersion: "2010-09-09"

Resources:
{%- for access_point in sceptre_user_data.access_points %}
{%- set access_point_name = access_point.name %}
  {{ access_point_name }}:
    Type: AWS::S3Outposts::Endpoint
    DeletionPolicy: {{ access_point.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ access_point.update_replace_policy | default('Delete') }}
    Properties:
      OutpostId: {{ access_point.outpost_id }}
      SecurityGroupId: {{ access_point.security_group_id }}
      SubnetId: {{ access_point.subnet_id }}
{%- if access_point.access_type is defined %}
      AccessType: {{ access_point.access_type }}
{%- endif %}
{%- if access_point.customer_owned_ipv4_pool is defined %}
      CustomerOwnedIpv4Pool: {{ access_point.customer_owned_ipv4_pool }}
{%- endif %}
{%- if access_point.failed_reason is defined %}{# BEGIN if access_point.failed_reason is defined #}
      FailedReason:
{%- if access_point.failed_reason.error_code is defined %}
        ErrorCode: {{ access_point.failed_reason.error_code }}
{%- endif %}
{%- if access_point.failed_reason.message is defined %}
        Message: {{ access_point.failed_reason.message }}
{%- endif %}
{%- endif %}{# END if access_point.failed_reason is defined #}
{%- endfor %}

Outputs:
{%- for access_point in sceptre_user_data.access_points %}
{%- set access_point_name = access_point.name %}
  {{ access_point_name }}:
    Description: The ARN for {{ access_point_name }}
    Value:
      Ref: {{ access_point_name }}
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}"
  {{ access_point_name }}Arn:
    Description: The ARN for {{ access_point_name }}
    Value:
      Fn::GetAtt:
        - {{ access_point_name }}
        - Arn
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}-Arn"
  {{ access_point_name }}CidrBlock:
    Description: The CIDR block for {{ access_point_name }}
    Value:
      Fn::GetAtt:
        - {{ access_point_name }}
        - CidrBlock
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}-CidrBlock"
  {{ access_point_name }}CreationTime:
    Description: The creation time for {{ access_point_name }}
    Value:
      Fn::GetAtt:
        - {{ access_point_name }}
        - CreationTime
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}-CreationTime"
  {{ access_point_name }}Status:
    Description: The status for {{ access_point_name }}
    Value:
      Fn::GetAtt:
        - {{ access_point_name }}
        - Status
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}-Status"
{%- endfor %}{#
# Supported structure as of 2026-07-05:
Type: AWS::S3Outposts::Endpoint
Properties:
  AccessType: String
  CustomerOwnedIpv4Pool: String
  FailedReason:
    ErrorCode: String
    Message: String
  OutpostId: String
  SecurityGroupId: String
  SubnetId: String
#}