---
Description: {{sceptre_user_data.description|default('S3Outposts Access Point(s) for '+sceptre_user_data.project_code)}}
AWSTemplateFormatVersion: "2010-09-09"

Resources:
{%- for access_point in sceptre_user_data.access_points %}
{%- set access_point_name = access_point.name %}
  {{ access_point_name }}:
    Type: AWS::S3Outposts::AccessPoint
    DeletionPolicy: {{ access_point.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ access_point.update_replace_policy | default('Delete') }}
    Properties:
      Bucket: {{ access_point.bucket }}
      Name: {{ access_point.access_point_name }}
{%- if access_point.policy_json is defined %}
      Policy: |-
        {{ access_point.policy_json | indent(width=8, first=false) }}
{%- elif access_point.policy is defined %}
      Policy:
        {{ access_point.policy | indent(width=8, first=false) }}
{%- endif %}
      VpcConfiguration:
{%- if access_point.vpc_configuration.vpc_id is defined %}
        VpcId: {{ access_point.vpc_configuration.vpc_id | trim }}
{%- endif %}
{%- endfor %}

Outputs:
{%- for access_point in sceptre_user_data.access_points %}
{%- set access_point_name = access_point.name %}
  {{ access_point_name }}:
    Description: The ARN for {{ access_point_name }}
    Value:
      Ref: {{ access_point_name }}
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}"
  {{ access_point_name }}Arn:
    Description: The ARN for {{ access_point_name }}
    Value:
      Fn::GetAtt:
        - {{ access_point_name }}
        - Arn
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}-Arn"
{%- endfor %}{#
# Supported structure as of 2026-07-05:
Type: AWS::S3Outposts::AccessPoint
Properties:
  Bucket: String
  Name: String
  Policy: Json
  VpcConfiguration:
    VpcId: String
#}