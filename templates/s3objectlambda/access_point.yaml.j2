---
Description: {{sceptre_user_data.description|default('S3ObjectLambda Access Point(s) for '+sceptre_user_data.project_code)}}
AWSTemplateFormatVersion: "2010-09-09"

Resources:
{%- for access_point in sceptre_user_data.access_points %}
{%- set access_point_name = access_point.name %}
  {{ access_point_name }}:
    Type: AWS::S3ObjectLambda::AccessPoint
    DeletionPolicy: {{ access_point.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ access_point.update_replace_policy | default('Delete') }}
    Properties:
{%- if access_point.access_point_name is defined %}
      Name: {{ access_point.access_point_name}}
{%- endif %}
      ObjectLambdaConfiguration:
        SupportingAccessPoint: {{ access_point.object_lambda_configuration.supporting_access_point }}
        TransformationConfigurations:
{%- for config in access_point.object_lambda_configuration.transformation_configurations %}{# BEGIN for config in access_point.object_lambda_configuration.transformation_configurations #}
          -
            Actions:
{%- for action in config.actions %}
              - {{ action }}
{%- endfor %}
            ContentTransformation:
              AwsLambda:
                FunctionArn: {{ config.content_transformation.aws_lambda.function_arn | trim }}
{%- if config.content_transformation.aws_lambda.function_payload is defined %}
                FunctionPayload: |-
                  {{ config.content_transformation.aws_lambda.function_payload | indent(width=18, first=false) }}
{%- endif %}
{%- endfor %}{# END for config in access_point.object_lambda_configuration.transformation_configurations #}
{%- if access_point.object_lambda_configuration.allowed_features is defined %}{# BEGIN if access_point.object_lambda_configuration.allowed_features is defined #}
        AllowedFeatures:
{%- for feature in access_point.object_lambda_configuration.allowed_features %}
          - {{ feature }}
{%- endfor %}
{%- endif %}{# END if access_point.object_lambda_configuration.allowed_features is defined #}
{%- if access_point.object_lambda_configuration.cloud_watch_metrics_enabled is defined %}
        CloudWatchMetricsEnabled: {{ access_point.object_lambda_configuration.cloud_watch_metrics_enabled | lower }}
{%- endif %}
{%- if access_point.access_point_policy is defined %}{# BEGIN if access_point.access_point_policy is defined #}
  {{ access_point_name }}Policy:
    Type: AWS::S3ObjectLambda::AccessPointPolicy
    DeletionPolicy: {{ access_point.deletion_policy | default('Delete') }}
    UpdateReplacePolicy: {{ access_point.update_replace_policy | default('Delete') }}
    Properties:
      ObjectLambdaAccessPoint:
        Ref: {{ access_point_name }}
{%- if access_point.access_point_policy.policy_document_json is defined %}
      PolicyDocument: |-
        {{ access_point.access_point_policy.policy_document_json | indent(width=8, first=false) }}
{%- elif access_point.access_point_policy.policy_document is defined %}
      PolicyDocument:
        {{ access_point.access_point_policy.policy_document | indent(width=8, first=false) }}
{%- endif %}
{%- endif %}{# END if access_point.access_point_policy is defined #}
{%- endfor %}

Outputs:
{%- for access_point in sceptre_user_data.access_points %}
{%- set access_point_name = access_point.name %}
  {{ access_point_name }}:
    Description: The access point ID for {{ access_point_name }}
    Value:
      Ref: {{ access_point_name }}
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}"
  {{ access_point_name }}Arn:
    Description: The ARN for {{ access_point_name }}
    Value:
      Fn::GetAtt:
        - {{ access_point_name }}
        - Arn
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}-Arn"
  {{ access_point_name }}CreationDate:
    Description: The creation date of the access point {{ access_point_name }}
    Value:
      Fn::GetAtt:
        - {{ access_point_name }}
        - CreationDate
    Export:
      Name:
        Fn::Sub: "${AWS::StackName}-{{ access_point_name }}-CreationDate"
{%- endfor %}{#
# Supported structure as of 2026-07-05:
Type: AWS::S3ObjectLambda::AccessPoint
Properties:
  Name: String
  ObjectLambdaConfiguration:
    AllowedFeatures:
      - String
    CloudWatchMetricsEnabled: Boolean
    SupportingAccessPoint: String
    TransformationConfigurations:
      -
        Actions:
          - String
        ContentTransformation:
          AwsLambda:
            FunctionArn: String
            FunctionPayload: String

Type: AWS::S3ObjectLambda::AccessPointPolicy
Properties:
  ObjectLambdaAccessPoint: String
  PolicyDocument: Json
#}