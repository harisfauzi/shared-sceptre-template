Properties:
{%- for key, component_property in component_child.properties.items() %}
  {{ key }}:
    {{- prep_component_property(component_property) | indent(width=4, first=false) }}
{%- endfor %}
{%- if component_child.children is defined %}{# BEGIN if component_child.children is defined #}
Children:
{%- for child in component_child.children %}
  -
    {{- prep_component_child(child) | indent(width=4, first=false) }}
{%- endfor %}
{%- endif %}{# END if component_child.children is defined #}
{%- if component_child.events is defined %}{# BEGIN if component_child.events is defined #}
Events:
{%- for key, component_event in component_child.events.items() %}
  {{ key }}:
    {{- prep_component_event(component_event) | indent(width=4, first=false) }}
{%- endfor %}
{%- endif %}{# END if component_child.events is defined #}
{%- if component_child.source_id is defined %}
SourceId: {{ component_child.source_id }}
{%- endif %}
{%- endmacro %}


{#
# ComponentDataConfiguration
