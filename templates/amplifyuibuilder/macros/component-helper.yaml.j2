# as of 2026-08-10:
BindingProperties:
  Bucket: String
  DefaultValue: String
  Field: String
  Key: String
  Model: String
  Predicates:
    - Predicate
  SlotName: String
  UserAttribute: String
DefaultValue: String
Type: String
#}{%- macro prep_component_binding_property(binding_property) %}
{%- if binding_property.binding_properties is defined %}{# BEGIN if binding_property.binding_properties is defined #}
BindingProperties:
{%- if binding_property.binding_properties.bucket is defined %}
  Bucket: {{ binding_property.binding_properties.bucket }}
{%- endif %}
{%- if binding_property.binding_properties.default_value is defined %}
  DefaultValue: {{ binding_property.binding_properties.default_value }}
{%- endif %}
{%- if binding_property.binding_properties.field is defined %}
  Field: {{ binding_property.binding_properties.field }}
{%- endif %}
{%- if binding_property.binding_properties.key is defined %}
  Key: {{ binding_property.binding_properties.key }}
{%- endif %}
{%- if binding_property.binding_properties.model is defined %}
  Model: {{ binding_property.binding_properties.model }}
{%- endif %}
{%- if binding_property.binding_properties.predicates is defined %}{# BEGIN if binding_property.binding_properties.predicates is defined #}
  Predicates:
{%- for predicate in binding_property.binding_properties.predicates %}
    -
      {{- prep_predicate(predicate) | indent(width=6, first=false) }}
{%- endfor %}
{%- endif %}{# END if binding_property.binding_properties.predicates is defined #}
{%- if binding_property.binding_properties.slot_name is defined %}
  SlotName: {{ binding_property.binding_properties.slot_name }}
{%- endif %}
{%- if binding_property.binding_properties.user_attribute is defined %}
  UserAttribute: {{ binding_property.binding_properties.user_attribute }}
{%- endif %}
{%- endif %}{# END if binding_property.binding_properties is defined #}
{%- if binding_property.default_value is defined %}
DefaultValue: {{ binding_property.default_value }}
{%- endif %}
{%- if binding_property.type is defined %}
Type: {{ binding_property.type }}
{%- endif %}
{%- endmacro %}

{#
# ComponentChild
# Supported structure as per https://docs.aws.amazon.com/AWSCloudFormation/latest/TemplateReference/aws-properties-amplifyuibuilder-component-componentchild.html
# as of 2026-08-10:
