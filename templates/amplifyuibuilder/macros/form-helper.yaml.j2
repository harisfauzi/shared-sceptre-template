{#
# FieldPosition
# Supported structure as per https://docs.aws.amazon.com/AWSCloudFormation/latest/TemplateReference/aws-properties-amplifyuibuilder-form-fieldposition.html
# as of 2026-08-13:
Below: String
Fixed: String
RightOf: String
#}{%- macro prep_field_position(field_position) %}
{%- if field_position.below is defined %}
Below: {{ field_position.below }}
{%- endif %}
{%- if field_position.fixed is defined %}
Fixed: {{ field_position.fixed }}
{%- endif %}
{%- if field_position.right_of is defined %}
RightOf: {{ field_position.right_of }}
{%- endif %}
{%- endmacro %}


{#
# SectionalElement
# Supported structure as per https://docs.aws.amazon.com/AWSCloudFormation/latest/TemplateReference/aws-properties-amplifyuibuilder-form-sectionalelement.html
# as of 2026-08-13:
Excluded: Boolean
Level: Number
Orientation: String
Position:
  FieldPosition
Text: String
Type: String
#}{%- macro prep_sectional_element(sectional_element) %}
Type: {{ sectional_element.type }}
{%- if sectional_element.excluded is defined %}
Excluded: {{ sectional_element.excluded | lower }}
{%- endif %}
{%- if sectional_element.level is defined %}
Level: {{ sectional_element.level }}
{%- endif %}
{%- if sectional_element.orientation is defined %}
Orientation: {{ sectional_element.orientation }}
{%- endif %}
{%- if sectional_element.position is defined %}
Position:
  {{- prep_field_position(sectional_element.position) | indent(width=2, first=false) }}
{%- endif %}
{%- if sectional_element.text is defined %}
Text: {{ sectional_element.text }}
{%- endif %}
{%- endmacro %}


